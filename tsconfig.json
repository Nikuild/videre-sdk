{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "strict": true, "skipLibCheck": true,
    "module": "esnext", "moduleResolution": "bundler", "resolveJsonModule": true, "isolatedModules": true,
    "esModuleInterop": true, "jsx": "react-jsx", "noEmit": true, "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts"]
}
